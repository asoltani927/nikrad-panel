{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "fastify"],
    "paths": {
      "@/*": ["./src/*"],
      "@shop/web-sdk": ["../../web-sdk/src"],
      "@nikrad/database": ["../packages/database"],
    }
  },
    "references": [
    { "path": "../../web-sdk" }
  ],
  "include": ["src/**/*.ts", "fastify.d.ts"],
  "exclude": ["node_modules", "prisma", "dist", "../../web-sdk/src"]
}
