{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "fastify"],
    "paths": {
      "@/*": ["./src/*"],
      "@nikrad/database": ["../packages/database"]
    }
  },
  "include": ["src/**/*.ts", "fastify.d.ts"],
  "exclude": ["node_modules", "prisma", "dist"]
}
